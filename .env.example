# Copy this to .env and fill in your values. Never commit .env.

# Your Grimmory instance base URL
GRIMMORY_URL=https://your-grimmory-instance.example.com

# Grimmory login credentials
GRIMMORY_USERNAME=your-username
GRIMMORY_PASSWORD=your-password

# Path to Kobo SQLite database (default shown — adjust if Kobo mounts elsewhere)
# KOBO_DB_PATH=/Volumes/KOBOeReader/.kobo/KoboReader.sqlite

# Where kobory stores sync state between runs (default shown)
# KOBORY_STATE_FILE=~/.local/share/kobory/state.json
